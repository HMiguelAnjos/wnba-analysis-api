meta {
  name: Média de pontos por quarto — últimos 10 jogos
  type: http
  seq: 3
}

get {
  url: {{base_url}}/players/{{player_id}}/analysis/points-by-period?season={{season}}&last_games=10
  body: none
  auth: none
}

params:query {
  season: {{season}}
  last_games: 10
}

docs {
  Calcula a média de pontos por quarto (1, 2, 3, 4, OT) com base nos últimos N jogos.

  ⚠️ Esta rota busca play-by-play para cada jogo. Com `last_games=10` pode levar 30–120s na primeira chamada.
}
